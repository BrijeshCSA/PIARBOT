# Токен группы (Управление → Работа с API → Ключи доступа)
VK_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID группы (можно с минусом или без)
VK_GROUP_ID=123456789

# Ваш user_id (числа из vk.com/id<ЧИСЛА>)
OWNER_ID=987654321

# Ссылка на сообщество (для кнопки «Подписаться» и бонуса 100₽)
COMMUNITY_LINK=https://vk.com/your_group

# (опционально) путь к БД
# DB_PATH=piar.db
